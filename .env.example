# Supabase Postgres: stores the conversation memory (LangGraph checkpoints).
# Supabase dashboard > Connect: use the "Direct connection" or "Session pooler" URI.
SUPABASE_POSTGRES_URI=
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# OpenRouter (LLM provider). API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model ids: https://openrouter.ai/models
LLM_MODEL=google/gemini-3.5-flash-lite
# Optional, smaller models for the guardrails and the router (default: LLM_MODEL).
# They must support structured outputs (JSON schema): https://openrouter.ai/models?supported_parameters=structured_outputs
LLM_GUARDRAIL_MODEL=
LLM_ROUTER_MODEL=

# Qdrant Cloud: cluster URL and API key from https://cloud.qdrant.io
# The collection must already contain your documents (or run scripts/seed_qdrant.py).
# Its vectors must match the embedding model in src/config/rag_config.py
# (default openai/text-embedding-3-small through OpenRouter: 1536 dimensions, Cosine).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=example_collection

LOG_LEVEL=INFO
